{
  "$id": "https://raw.githubusercontent.com/Kiyozz/papyrus-tools/main/schemas/papyrus.schema.json",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "description": "The configuration of a Papyrus project, for the papyrus toolchain.",
  "properties": {
    "build": {
      "additionalProperties": false,
      "description": "How `papyrus build` compiles.",
      "properties": {
        "compiler": {
          "description": "PapyrusCompiler.exe, or Caprica. By default, the Creation Kit's of a default Steam installation.",
          "type": "string"
        },
        "final": {
          "default": false,
          "description": "Strip BetaOnly code (Fallout 4 onwards).",
          "type": "boolean"
        },
        "optimize": {
          "default": false,
          "description": "Optimize the bytecode.",
          "type": "boolean"
        },
        "output": {
          "description": "Where the .pex files go, relative to this file. Scripts by default.",
          "type": "string"
        },
        "release": {
          "default": false,
          "description": "Strip DebugOnly code (Fallout 4 onwards).",
          "type": "boolean"
        }
      },
      "type": "object"
    },
    "flags": {
      "description": "A .flg file replacing the game's vanilla flags, relative to this file.",
      "type": "string"
    },
    "fmt": {
      "additionalProperties": false,
      "description": "The formatter.",
      "properties": {
        "indent": {
          "description": "1 to 8 spaces, or \"tab\". 2 spaces by default.",
          "oneOf": [
            {
              "maximum": 8,
              "minimum": 1,
              "type": "integer"
            },
            {
              "enum": [
                "tab"
              ],
              "type": "string"
            }
          ]
        }
      },
      "type": "object"
    },
    "game": {
      "description": "The target game. Without it, it is inferred from the scripts.",
      "enum": [
        "skyrim",
        "fallout4",
        "fallout76",
        "starfield",
        "sse",
        "skyrimse",
        "skyrimle",
        "skyrimae",
        "tesv",
        "fo4",
        "fo76",
        "sf"
      ],
      "type": "string"
    },
    "imports": {
      "description": "Folders of scripts the project builds on — a library, another mod, the game's sources — read but never checked, relative to this file.",
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "include-fragments": {
      "default": false,
      "description": "Check the fragments generated by the Creation Kit too.",
      "type": "boolean"
    },
    "lints": {
      "additionalProperties": false,
      "description": "The level of each lint, by name or by code.",
      "properties": {
        "PAP001": {
          "description": "string or docstring the target's compiler will silently corrupt (PAP001, warn by default)",
          "enum": [
            "allow",
            "warn",
            "error",
            "off",
            "warning",
            "deny"
          ],
          "enumDescriptions": [
            "Disabled.",
            "Reported as a warning.",
            "Reported as an error.",
            "Same as allow.",
            "Same as warn.",
            "Same as error."
          ],
          "type": "string"
        },
        "PAP002": {
          "description": "flag the game's .flg file does not allow on this object (PAP002, error by default)",
          "enum": [
            "allow",
            "warn",
            "error",
            "off",
            "warning",
            "deny"
          ],
