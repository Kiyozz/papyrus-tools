<?xml version="1.0" encoding="UTF-8"?>
<PapyrusProject xmlns="PapyrusProject.xsd" Game="sse" Flags="TESV_Papyrus_Flags.flg"
    Output="@build/Scripts" Optimize="true" Anonymize="true" Package="true" Zip="true">
  <Variables>
    <Variable Name="build" Value="@root/Build"/>
    <Variable Name="root" Value="@{PROJECT_PATH}"/>
  </Variables>
  <Imports>
    <Import>@root/Source</Import>
    <Import>.\Lib</Import>
    <Import>GAME_SOURCES</Import>
    <Import>https://github.com/example/framework/tree/main/Source</Import>
  </Imports>
  <Scripts>
    <Script>HomesteadMain.psc</Script>
  </Scripts>
  <Packages Output="@build">
    <Package Name="Homestead" RootDir="@build"/>
  </Packages>
  <ZipFiles Output="@build">
    <ZipFile Name="Homestead" RootDir="@build"/>
  </ZipFiles>
  <PostBuildEvent Description="Must stay Pyro's: papyrus never runs it" UseInBuild="true">
    <Command>cmd /c echo ran &gt; "@root/ran.txt"</Command>
    <Command>touch "@root/ran.txt"</Command>
  </PostBuildEvent>
</PapyrusProject>
