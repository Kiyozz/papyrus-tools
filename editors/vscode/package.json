{
  "name": "papyrus-tools",
  "displayName": "Papyrus",
  "description": "Diagnostics, formatting and lints for Papyrus, the scripting language of Skyrim, Fallout 4 and Starfield",
  "version": "0.9.0",
  "publisher": "kiyozz",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/kiyozz/papyrus-tools"
  },
  "engines": {
    "vscode": "^1.91.0"
  },
  "categories": [
    "Programming Languages",
    "Linters",
    "Formatters"
  ],
  "keywords": [
    "papyrus",
    "skyrim",
    "fallout",
    "starfield",
    "creation kit"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "workspaceContains:**/papyrus.toml",
    "onTaskType:papyrus"
  ],
  "contributes": {
    "languages": [
      {
        "id": "papyrus",
        "aliases": [
          "Papyrus"
        ],
        "extensions": [
          ".psc"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "papyrus",
        "scopeName": "source.papyrus",
        "path": "./syntaxes/papyrus.tmLanguage.json"
      }
    ],
    "configuration": {
      "title": "Papyrus",
      "properties": {
        "papyrus.server.path": {
          "type": "string",
          "default": "",
          "markdownDescription": "Path of the `papyrus` binary. Empty: the one bundled with the extension, else `papyrus` from the `PATH`."
        },
        "papyrus.inlayHints.parameterNames": {
          "type": "string",
          "enum": [
            "none",
            "literals",
            "all"
          ],
          "enumDescriptions": [
            "No parameter names.",
            "Before literals only: `Disable(abFadeOut: true)`.",
            "Before every argument, unless it already carries the name."
          ],
          "default": "literals",
          "markdownDescription": "Show the name of the parameter before the arguments of a call. `editor.inlayHints.enabled` turns every hint off."
        },
        "papyrus.trace.server": {
          "type": "string",
          "enum": [
            "off",
            "messages",
            "verbose"
          ],
          "default": "off",
          "description": "Trace the communication with the server, in the \"Papyrus\" output."
        }
      }
    },
    "commands": [
      {
        "command": "papyrus.restart",
        "title": "Restart the server",
        "category": "Papyrus"
      },
      {
        "command": "papyrus.createConfig",
        "title": "Create papyrus.toml",
        "category": "Papyrus"
      }
    ],
    "snippets": [
      {
        "language": "papyrus",
        "path": "./snippets/papyrus.json"
      }
    ],
    "taskDefinitions": [
      {
        "type": "papyrus",
        "required": [
          "command"
        ],
        "properties": {
          "command": {
            "type": "string",
            "enum": [
              "build",
              "check"
            ],
            "description": "`build`: compile with the compiler of papyrus.toml. `check`: report the lints of every script."
          },
          "args": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "More arguments: `--release`, `--optimize`, a folder…"
          }
        }
      }
    ],
    "problemMatchers": [
      {
        "name": "papyrus",
        "owner": "papyrus-task",
        "source": "papyrus",
        "fileLocation": "absolute",
        "pattern": {
          "regexp": "^(.+):(\\d+):(\\d+):(\\d+):(\\d+): (error|warning)\\[([^\\]]+)\\]: (.*)$",
          "file": 1,
          "line": 2,
          "column": 3,
          "endLine": 4,
          "endColumn": 5,
          "severity": 6,
          "code": 7,
          "message": 8
        }
      }
    ],
    "tomlValidation": [
      {
        "fileMatch": "papyrus.toml",
        "url": "https://raw.githubusercontent.com/Kiyozz/papyrus-tools/main/schemas/papyrus.schema.json"
      }
    ]
  },
  "dependencies": {
    "vscode-languageclient": "^10.1.2"
  },
  "devDependencies": {
    "@vscode/vsce": "^4.0.0",
    "esbuild": "^0.28.2",
    "vscode-tmgrammar-test": "^0.1.3"
  },
  "scripts": {
    "bundle": "esbuild extension.js --bundle --platform=node --format=cjs --target=node20 --external:vscode --minify --outfile=dist/extension.js",
    "vscode:prepublish": "npm run bundle",
    "test:grammar": "vscode-tmgrammar-test \"tests/grammar/*.psc\"",
    "package": "vsce package"
  }
}
